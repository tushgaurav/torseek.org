PORT=8000
CORS_ORIGIN=http://localhost:5173

# Jackett (torrent indexer aggregator). See README "Running Jackett".
# Leave JACKETT_API_KEY empty to serve fixture results from fixtures/ instead.
JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=

# PostHog (same project token as the web app). Leave empty to skip server events.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Optional tuning
# JACKETT_TIMEOUT_MS=30000      # per-request timeout to Jackett
# SEARCH_CACHE_TTL_MS=600000    # how long a result set is kept for paging/sorting
# REQUIRE_JACKETT=true          # refuse to start without an API key (set in production)
